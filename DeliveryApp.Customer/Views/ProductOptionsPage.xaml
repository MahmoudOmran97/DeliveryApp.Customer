<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeliveryApp.Customer.ViewModels"
             xmlns:m="clr-namespace:DeliveryApp.Customer.Models"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:loc="clr-namespace:DeliveryApp.Customer.Converters"
             x:Class="DeliveryApp.Customer.Views.ProductOptionsPage"
             x:DataType="vm:ProductOptionsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="#80000000">

    <Grid Padding="0" RowDefinitions="*,Auto">
        <BoxView Grid.RowSpan="2" Color="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand}"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="Sheet" Grid.Row="1" BackgroundColor="White"
                StrokeShape="RoundRectangle 24,24,0,0"
                Stroke="Transparent" Padding="20,16,20,28">
            <!-- ✅ المحتوى بقى جوه ScrollView (عشان لو فيه مقاسات + مجموعات اختيارات كتير الشاشة تسكرول)،
                 وصف الكمية وزرار الإضافة ثابتين تحت. -->
            <Grid RowDefinitions="*,Auto" RowSpacing="14">
            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16">
                <!-- ✅ FIX: صورة المنتج مكنتش ظاهرة في شاشة التفاصيل خالص -->
                <!-- ✅ FIX: دلوقتي تقدر تدوس على الصورة تفتحلك بحجمها الكامل مع إمكانية الزوم -->
                <Border StrokeShape="RoundRectangle 16" HeightRequest="180"  Stroke="#FF5722"
                        IsVisible="{Binding Product.FullImageUrl, Converter={StaticResource HasImage}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenImageCommand}"/>
                    </Border.GestureRecognizers>
                    <!-- 🔧 PERF FIX: كانت <Image> عادية (بتحمّل من النت من غير caching
                         ولا downsample) — استبدلناها بـ ff:CachedImage زي باقي صفحات
                         المنتجات (RestaurantPage, HomePage...) عشان تتكاش وتترسم
                         بحجم العرض الفعلي بس، مش الحجم الأصلي من السيرفر. -->
                    <ff:CachedImage Source="{Binding Product.FullImageUrl}"
                                    Aspect="AspectFill"
                                    CacheDuration="7"
                                    DownsampleToViewSize="True"
                                    HeightRequest="180"/>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{Binding Product.Name}" FontFamily="CairoBold" FontSize="20" TextColor="#212121"/>
                        <Label Text="{Binding Product.Description}" FontFamily="CairoRegular"
               FontSize="13" TextColor="#757575"/>
                        <!-- ✅ FIX: كان بيعرض Product.Price (السعر قبل الخصم) دايمًا حتى لو المنتج عليه خصم.
             دلوقتي بيعرض EffectivePrice (السعر بعد الخصم لو موجود)، ولو فيه خصم
             فعلاً بيظهر السعر القديم مشطوب عليه جنبه. -->
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding Product.EffectivePrice, StringFormat='{0:F0} EGP'}"
                   FontFamily="CairoBold" FontSize="15" TextColor="#FF5722"/>
                            <Label Text="{Binding Product.OriginalPriceText}"
                   FontFamily="CairoRegular" FontSize="13" TextColor="#9E9E9E"
                   TextDecorations="Strikethrough"
                   IsVisible="{Binding Product.HasDiscount}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="✕" FontSize="22" TextColor="#757575" Padding="8">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- ✅ FIX: قسم اختيار المقاس بيظهر بس لو المنتج فعلاً عنده Variants -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasVariants}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Loc Key=ChooseSize}" FontFamily="CairoBold" FontSize="16"/>
                        <Border BackgroundColor="#212121" StrokeShape="RoundRectangle 6" Padding="8,4">
                            <Label Text="{loc:Loc Key=Required}" FontFamily="CairoBold" FontSize="11" TextColor="White"/>
                        </Border>
                    </Grid>
                    <Label Text="{loc:Loc Key=ChooseOne}" FontFamily="CairoRegular" FontSize="12" TextColor="#757575"/>

                    <CollectionView ItemsSource="{Binding Variants}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:ProductVariant">
                                <Border Stroke="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}"
                                        StrokeThickness="2"
                                        BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#FFF3EF|#FFFFFF}"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="110" Padding="12,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductOptionsViewModel}}, Path=SelectVariantCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="13"/>
                                        <Label Text="{Binding PriceText}" FontFamily="CairoBold"
                                               FontSize="12" TextColor="#FF5722"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ✅ FEATURE: مجموعات الاختيارات (اختار 2 صوص من 8 ...) -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding HasOptionGroups}"
                                     BindableLayout.ItemsSource="{Binding OptionGroups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:ProductOptionGroup">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontFamily="CairoBold" FontSize="16"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding CounterText}" FontFamily="CairoBold" FontSize="13"
                                           TextColor="#FF5722" VerticalOptions="Center"/>
                                    <Border Grid.Column="2" BackgroundColor="#212121" StrokeShape="RoundRectangle 6" Padding="8,4"
                                            IsVisible="{Binding IsRequired}">
                                        <Label Text="{loc:Loc Key=Required}" FontFamily="CairoBold" FontSize="11" TextColor="White"/>
                                    </Border>
                                </Grid>
                                <Label Text="{Binding RuleText}" FontFamily="CairoRegular" FontSize="12" TextColor="#757575"/>

                                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start"
                                            BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="m:ProductOptionItem">
                                            <Border Margin="0,0,8,8" Padding="12,8" StrokeShape="RoundRectangle 20"
                                                    StrokeThickness="2"
                                                    Stroke="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}"
                                                    BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#FFF3EF|#FFFFFF}"
                                                    IsEnabled="{Binding IsDisabled, Converter={StaticResource InvertBool}}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsDisabled}" Value="True">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductOptionsViewModel}}, Path=ToggleOptionCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="✓" FontFamily="CairoBold" FontSize="13" TextColor="#FF5722"
                                                           IsVisible="{Binding IsSelected}" VerticalOptions="Center"/>
                                                    <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="13"
                                                           TextColor="#212121" VerticalOptions="Center"/>
                                                    <Label Text="{Binding PriceText}" FontFamily="CairoBold" FontSize="12"
                                                           TextColor="#FF5722" IsVisible="{Binding HasExtra}" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                        <Border BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8" Padding="8">
                            <Image Source="icon_minus.png" WidthRequest="30" HeightRequest="30" Aspect="AspectFit">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DecreaseQtyCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                        <Label Text="{Binding Quantity}" FontFamily="CairoBold" FontSize="18" VerticalOptions="Center"/>
                        <Border BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8" Padding="8">
                            <Image Source="icon_plus.png" WidthRequest="30" HeightRequest="30" Aspect="AspectFit">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding IncreaseQtyCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                    </HorizontalStackLayout>

                    <Border Grid.Column="2" BackgroundColor="#FF5722"
                            StrokeShape="RoundRectangle 14" Padding="20,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddToCartCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding AddButtonText}" FontFamily="CairoBold"
                               FontSize="14" TextColor="White"/>
                    </Border>
                </Grid>
            </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>