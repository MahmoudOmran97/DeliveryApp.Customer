<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeliveryApp.Customer.ViewModels"
             xmlns:loc="clr-namespace:DeliveryApp.Customer.Converters"
             x:Class="DeliveryApp.Customer.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FF5722">

    <!-- ✅ FIX (تغطية شريط الساعة فوق + مفيش سكرول فبيتغطى آخر عناصر الفورم تحت):
         الصفحة القديمة كانت Grid RowDefinitions="280,*" جوه ScrollView.
         الصف "*" جوه ScrollView بياخد ارتفاع صفر لأن الـ ScrollView بيدّي المحتوى
         ارتفاع لا نهائي وقت القياس، فالكارت الأبيض (اللي كان VerticalOptions="End"
         و RowSpan="2") كان بيتحسب على أساس ارتفاع الصف الأول بس (280px) وأي حاجة
         زيادة فايضة برة حدود الـ ScrollView من غير Scrollbar ومن غير ما اليوزر
         يقدر يوصلها = زرار الدخول ورابط "مفيش حساب؟ سجل" بيتقصوا/يتغطوا بشريط
         الأزرار السفلي للموبايل. وكمان مكانش فيه Padding علوي يراعي شريط الساعة
         (الصفحات التانية زي Home/Category بتستخدم Padding علوي 52 لنفس السبب).
         الحل: Grid عادي بارتفاع Auto بدل الـ RowDefinitions Star، جوه
         VerticalStackLayout (بيتقاس صح جوه ScrollView)، + Padding علوي 52
         + Padding سفلي كافي في الكارت الأبيض. -->
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Orange top section -->
            <Grid Padding="20,52,20,36" RowDefinitions="Auto,Auto">

                <!-- Language toggle -->
                <Border Grid.Row="0" HorizontalOptions="End" VerticalOptions="Start"
                        Padding="12,6"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#FFCCBC"
                        BackgroundColor="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleLanguageCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding OtherLanguageLabel}"
                           FontFamily="CairoRegular" FontSize="13" TextColor="White"/>
                </Border>

                <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center"
                                     Padding="0,24,0,0" Spacing="10">
                    <Image x:Name="imgLogo"
                           Aspect="AspectFill"
                           HeightRequest="110"
                           WidthRequest="110"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Label Text="{loc:Loc Key=WelcomeBack}"
                           FontFamily="CairoBold" FontSize="30" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="{loc:Loc Key=SignInToContinue}"
                           FontFamily="CairoRegular" FontSize="14" TextColor="#FFCCBC" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!-- White card -->
            <Border BackgroundColor="#F8F9FA"
                    StrokeShape="RoundRectangle 32,32,0,0"
                    Stroke="Transparent"
                    Margin="0,-24,0,0"
                    Padding="28,32,28,48">
                <VerticalStackLayout Spacing="18">

                    <Label Text="{loc:Loc Key=Login}"
                           FontFamily="CairoBold" FontSize="26" TextColor="#212121"/>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Loc Key=Email}"
                               FontFamily="CairoRegular" FontSize="13" TextColor="#757575"/>
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Placeholder="{loc:Loc Key=EmailPlaceholder}"
                                   Text="{Binding Email}"
                                   Keyboard="Email" HeightRequest="50"
                                   BackgroundColor="Transparent"
                                   FontFamily="CairoRegular" FontSize="15" TextColor="#212121"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Loc Key=Password}"
                               FontFamily="CairoRegular" FontSize="13" TextColor="#757575"/>
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Placeholder="{loc:Loc Key=PasswordPlaceholder}"
                                   Text="{Binding Password}"
                                   IsPassword="True"
                                   HeightRequest="50" BackgroundColor="Transparent"
                                   FontFamily="CairoRegular" FontSize="15" TextColor="#212121"
                                   ReturnCommand="{Binding LoginCommand}"/>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{loc:Loc Key=ForgotPassword}"
                           FontFamily="CairoRegular" FontSize="13" TextColor="#FF5722"
                           HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToForgotPasswordCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Button Text="{loc:Loc Key=Login}"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="0,6,0,0"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="#FF5722" HorizontalOptions="Center"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{loc:Loc Key=DontHaveAccount}"
                               FontFamily="CairoRegular" FontSize="14" TextColor="#757575" VerticalOptions="Center"/>
                        <Label Text="{loc:Loc Key=Register}"
                               FontFamily="CairoBold" FontSize="14" TextColor="#FF5722" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRegisterCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
