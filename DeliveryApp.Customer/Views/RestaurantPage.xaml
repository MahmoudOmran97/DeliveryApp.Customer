<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             xmlns:vm="clr-namespace:DeliveryApp.Customer.ViewModels"

             xmlns:m="clr-namespace:DeliveryApp.Customer.Models"

             xmlns:loc="clr-namespace:DeliveryApp.Customer.Converters"
             xmlns:h="clr-namespace:DeliveryApp.Customer.Helpers"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"

             x:Class="DeliveryApp.Customer.Views.RestaurantPage"

             x:Name="RootPage"

             x:DataType="vm:RestaurantViewModel"

             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <DataTemplate x:Key="CategoryChipTemplate" x:DataType="m:Category">
            <VerticalStackLayout  Padding="0,0" WidthRequest="66" HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryChipTapped" CommandParameter="{Binding .}"/>
                </VerticalStackLayout.GestureRecognizers>

                <Border BackgroundColor="#FFF3EC" StrokeShape="RoundRectangle 14"
                        Stroke="#EBD8C2" StrokeThickness="1.5" WidthRequest="60" HeightRequest="60"
                        HorizontalOptions="Center">
                    <Grid>

                        <Label Text="🍽️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}"/>

                        <ff:CachedImage Source="{Binding FullImageUrl}"
                               Aspect="AspectFill"
                               CacheDuration="7"
                               DownsampleToViewSize="True"
                               HeightRequest="60" WidthRequest="60"
                               IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}}"/>
                    </Grid>
                </Border>

                <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="11"
                       TextColor="#212121" HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation" MaxLines="1"/>

            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="CategoryGridTemplate" x:DataType="m:Category">
            <Border Style="{StaticResource CardListItem}" Margin="6" Padding="6" WidthRequest="130">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.GoToCategoryCommand}"
                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border BackgroundColor="#FFF3EC" StrokeShape="RoundRectangle 36" Stroke="#FFD9C2" StrokeThickness="1"
                            WidthRequest="72" HeightRequest="72">
                        <Grid>
                            <Label Text="🛍️" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}"/>
                            <ff:CachedImage Source="{Binding FullImageUrl}" Aspect="AspectFill"
                                   CacheDuration="7" DownsampleToViewSize="True"
                                   IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}}"/>
                        </Grid>
                    </Border>
                    <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="12" TextColor="#212121"
                           HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>


        <DataTemplate x:Key="BestSellerTemplate" x:DataType="m:Product">
            <!-- 🔧 PERF FIX: شلنا Border.Shadow (كان بيتترسم من جديد لكل عنصر
                 كل ما القايمة الأفقية دي تتعاد رسمها أثناء السكرول). -->
            <Border BackgroundColor="#FFF8F3" StrokeShape="RoundRectangle 20" Stroke="#FFD9C2"
                    StrokeThickness="1.2" WidthRequest="150" Margin="0,4,10,4" Padding="9,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ProductTappedCommand}"
                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="5">
                    <Grid>
                        <Border BackgroundColor="#F0F0F0" StrokeShape="RoundRectangle 16" Stroke="Transparent" HeightRequest="88">
                            <Grid>
                                <Label Text="🔥" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}"/>
                                <ff:CachedImage Source="{Binding FullImageUrl}" Aspect="AspectFill"
                                       CacheDuration="7" DownsampleToViewSize="True"
                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}}"/>
                            </Grid>
                        </Border>

                        <!-- شارة "الأفضل مبيعًا" -->
                        <Border BackgroundColor="#FF5722" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                HorizontalOptions="Start" VerticalOptions="Start" Margin="4" Padding="5,2">
                            <Label Text="🔥" FontSize="10"/>
                        </Border>


                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 13" Stroke="#EEEEEE"
                                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-4,-4"
                                WidthRequest="35" HeightRequest="35"
                                IsVisible="{Binding HasVariants, Converter={StaticResource InvertBool}}">
                            <Image Source="icon_add.png" WidthRequest="25" HeightRequest="25"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.AddToCartCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                    </Grid>

                    <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="12" MaxLines="2"
                           LineBreakMode="TailTruncation" HeightRequest="40" VerticalTextAlignment="Start"/>
                    <Label Text="{Binding PriceText}" FontFamily="CairoBold" FontSize="13" TextColor="#FF5722"/>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!-- عنوان القسم والمنتج في صف واحد مسطّح؛ وجود العنوان كعنصر مستقل
             يجعل ScrollTo يقف عند عنوان القسم نفسه. -->
        <DataTemplate x:Key="MenuRowTemplate" x:DataType="h:RestaurantMenuRow">
            <VerticalStackLayout Spacing="0">
                <Border BackgroundColor="#FFF3EC" Stroke="#FFD9C2" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Margin="16,14,16,6" Padding="14,10"
                        IsVisible="{Binding IsSectionHeader}">
                    <Label Text="{Binding SectionName}" FontFamily="CairoBold" FontSize="16"
                           TextColor="#212121" LineBreakMode="TailTruncation" MaxLines="1"/>
                </Border>

                <Border Style="{StaticResource CardListItem}" Margin="16,0,16,10"
                        IsVisible="{Binding IsProduct}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ProductTappedCommand}"
                            CommandParameter="{Binding Product}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,84" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                            <Label Text="{Binding Product.Name}" FontFamily="CairoBold" FontSize="14" TextColor="#212121"/>
                            <Label Text="{Binding Product.Description}" FontFamily="CairoRegular"
                                   FontSize="12" TextColor="#757575" MaxLines="2" LineBreakMode="TailTruncation"/>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Product.PriceText}" FontFamily="CairoBold"
                                       FontSize="15" TextColor="#FF5722"/>
                                <Label Text="{Binding Product.OriginalPriceText}" FontFamily="CairoRegular"
                                       FontSize="12" TextColor="#BDBDBD"
                                       IsVisible="{Binding Product.HasDiscount}"
                                       TextDecorations="Strikethrough"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Grid Grid.Column="1">
                            <Border BackgroundColor="#F0F0F0" StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent" HeightRequest="84">
                                <Grid>
                                    <Label Text="🍛" FontSize="36"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           IsVisible="{Binding Product.FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}" />
                                    <ff:CachedImage Source="{Binding Product.FullImageUrl}"
                                           Aspect="AspectFill" HeightRequest="84" WidthRequest="84"
                                           CacheDuration="7" DownsampleToViewSize="True"
                                           IsVisible="{Binding Product.FullImageUrl, Converter={StaticResource HasImage}}" />
                                </Grid>
                            </Border>

                            <Image Source="icon_plus.png" WidthRequest="34" HeightRequest="34"
                                   HorizontalOptions="End" VerticalOptions="End"
                                   IsVisible="{Binding Product.HasVariants, Converter={StaticResource InvertBool}}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.AddToCartCommand}"
                                        CommandParameter="{Binding Product}"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <Label Text="›" FontSize="28" TextColor="#FF5722"
                                   HorizontalOptions="End" VerticalOptions="End"
                                   IsVisible="{Binding Product.HasVariants}"/>
                        </Grid>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>


    <!-- في .NET MAUI 9 يجب إلغاء Safe Area على الـ Layout نفسه للوصول إلى edge-to-edge. -->
    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource Background}" IgnoreSafeArea="True">


        <CollectionView x:Name="MenuCollectionView" Grid.Row="1"
                        ItemsSource="{Binding MenuRows}" ItemTemplate="{StaticResource MenuRowTemplate}" SelectionMode="None"
                        IsVisible="{Binding IsGroceryStoreLayout, Converter={StaticResource InvertBool}}"
                        Scrolled="OnContentScrolled">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0"   >

                    <!-- ✅ Cover: بحواف ناعمة وتصميم احترافي -->
                    <!-- يبدأ الغلاف تحت الهيدر الثابت حتى لا تخفيه الخلفية -->
                    <Border x:Name="RestaurantCover" StrokeShape="RoundRectangle 0,0,32,32" Stroke="Transparent"
                            HeightRequest="240" Margin="0" VerticalOptions="Start" >
                        <Grid>

                            <Label Text="🖼️" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"
                                   Opacity="0.3" IsVisible="{Binding Restaurant.FullCoverImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}"/>
                            <ff:CachedImage Source="{Binding Restaurant.FullCoverImageUrl}" Aspect="AspectFill"
                                   CacheDuration="7" DownsampleToViewSize="True"
                                   IsVisible="{Binding Restaurant.FullCoverImageUrl, Converter={StaticResource HasImage}}"/>

                            <!-- Overlay gradient for better text readability if needed -->

                        </Grid>
                    </Border>

                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 32" Stroke="#FFD9C2"
                        StrokeThickness="1.5" WidthRequest="64" HeightRequest="64"
                        HorizontalOptions="End" Margin="0,-32,20,-32" ZIndex="1">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,3" Opacity="0.18" Radius="8"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="⭐" FontSize="15" HorizontalOptions="Center"/>
                            <Label Text="{Binding Restaurant.RatingText}" FontFamily="CairoBold" FontSize="12"
                               TextColor="#212121" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>



                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 32,32,0,0"

                        Stroke="Transparent" Padding="20,18,20,16">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="{Binding Restaurant.Name}" FontFamily="CairoBold" FontSize="22"
                               TextColor="#212121" MaxLines="2" LineBreakMode="TailTruncation"/>

                            <Label Text="{Binding Restaurant.Description}" FontFamily="CairoRegular"

                               FontSize="13" TextColor="#757575"/>

                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,4,0,0">
                                <HorizontalStackLayout Spacing="8">

                                    <Border BackgroundColor="#FFF3EC" StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="12,7">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="🛵" FontSize="12" VerticalOptions="Center"/>
                                            <Label Text="{Binding Restaurant.DeliveryFeeText}" FontFamily="CairoBold" FontSize="13" TextColor="#FF5722" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border BackgroundColor="#FFF3EC" StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="12,7">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="⏱️" FontSize="12" VerticalOptions="Center"/>
                                            <Label Text="{Binding Restaurant.EstimatedTimeText}" FontFamily="CairoBold" FontSize="13" TextColor="#212121" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border BackgroundColor="#FFF3EC" StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="12,7"
                                        IsVisible="{Binding Restaurant.DistanceKm, Converter={StaticResource IntToBool}}">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="📍" FontSize="12" VerticalOptions="Center"/>
                                            <Label Text="{Binding Restaurant.DistanceKm, StringFormat='{0:F1} km'}" FontFamily="CairoBold" FontSize="13" TextColor="#212121" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                </HorizontalStackLayout>
                            </ScrollView>

                        </VerticalStackLayout>

                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#FF5722" Margin="0,16"/>


                    <Border BackgroundColor="White" Stroke="Transparent" HeightRequest="150" Margin="0,15,0,10" Padding="0,35,0,0"
                            IsVisible="{Binding Menu.Count, Converter={StaticResource IntToBool}}"
                            SizeChanged="OnInlineCategoriesBarSizeChanged">
                        <CollectionView x:Name="InlineCategoriesBar" 
                                    ItemsSource="{Binding Menu}" SelectionMode="None"
                                    ItemTemplate="{StaticResource CategoryChipTemplate}"
                                    HeightRequest="110">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="0" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.Header>
                                <BoxView WidthRequest="16" Color="Transparent"/>
                            </CollectionView.Header>
                            <CollectionView.Footer>
                                <BoxView WidthRequest="16" Color="Transparent"/>
                            </CollectionView.Footer>
                        </CollectionView>
                    </Border>

                    <BoxView HeightRequest="1" Color="#F0F0F0"
                         IsVisible="{Binding Menu.Count, Converter={StaticResource IntToBool}}"
                         Margin="16,4,16,0"/>


                    <Border IsVisible="{Binding HasActivePrescriptionChat}" BackgroundColor="#FFF3E0"
                        StrokeShape="RoundRectangle 14" Stroke="#FFB74D" Margin="16,8,16,0"
                        Padding="16,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{loc:Loc Key=PrescriptionChatOngoingTitle}" FontFamily="CairoBold"
                                   FontSize="14" TextColor="#E65100"/>
                                <Label Text="{loc:Loc Key=PrescriptionChatOngoingHint}" FontFamily="CairoRegular"
                                   FontSize="12" TextColor="#424242"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="{loc:Loc Key=ReturnToChat}"
                                Command="{Binding ReturnToPrescriptionChatCommand}"
                                BackgroundColor="#FF5722" TextColor="White"
                                FontFamily="CairoBold" FontSize="13"
                                CornerRadius="10" Padding="14,0" HeightRequest="42"
                                VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Pharmacy: upload prescription -->
                    <Border IsVisible="{Binding IsPharmacy}" BackgroundColor="#E3F2FD"
                        StrokeShape="RoundRectangle 14" Stroke="#90CAF9" Margin="16,8"
                        Padding="16,14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{loc:Loc Key=UploadPrescription}" FontFamily="CairoBold"
                               FontSize="16" TextColor="#1565C0"/>
                            <Label Text="{loc:Loc Key=PrescriptionHint}" FontFamily="CairoRegular"
                               FontSize="13" TextColor="#424242"/>
                            <Button Text="{loc:Loc Key=ChoosePrescriptionImage}"
                                Command="{Binding UploadPrescriptionCommand}"
                                BackgroundColor="#1976D2" TextColor="White"
                                FontFamily="CairoBold" CornerRadius="10"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </CollectionView.Header>


            <CollectionView.Footer>

                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout Spacing="10" Margin="16,16,0,20"
                                          IsVisible="{Binding BestSellers.Count, Converter={StaticResource IntToBool}}">
                        <Label Text="{loc:Loc Key=BestSellersTitle}" FontFamily="CairoBold" FontSize="17" TextColor="#212121"/>
                        <CollectionView ItemsSource="{Binding BestSellers}" SelectionMode="None"
                                        ItemsLayout="HorizontalList" ItemTemplate="{StaticResource BestSellerTemplate}"
                                        HeightRequest="233" Margin="0,0,0,4"/>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="100" Color="Transparent"/>
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>


        <ScrollView x:Name="GroceryScrollView" Grid.Row="1"
                    IsVisible="{Binding IsGroceryStoreLayout}" Scrolled="OnGroceryScrolled">
            <VerticalStackLayout Spacing="0">

                <!-- ✅ Cover: بحواف ناعمة وتصميم احترافي (للسوبر ماركت/الصيدلية) -->
                <!-- يبدأ الغلاف تحت الهيدر الثابت في تخطيط المتجر/الصيدلية أيضًا -->
                <Border x:Name="GroceryCover" StrokeShape="RoundRectangle 0,0,32,32" Stroke="Transparent"
                        HeightRequest="240" Margin="0,0,0,-20">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1F2A30" Offset="0.0"/>
                                <GradientStop Color="#2E3A42" Offset="0.55"/>
                                <GradientStop Color="#FF5722" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Label Text="🍽️" FontSize="80" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding Restaurant.FullCoverImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}" />
                        <ff:CachedImage Source="{Binding Restaurant.FullCoverImageUrl}"
                               Aspect="AspectFill" CacheDuration="7" DownsampleToViewSize="True"
                               IsVisible="{Binding Restaurant.FullCoverImageUrl, Converter={StaticResource HasImage}}" />

                        <!-- Overlay gradient -->
                        <BoxView VerticalOptions="Fill" HorizontalOptions="Fill">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.6"/>
                                    <GradientStop Color="#40000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                    </Grid>
                </Border>


                <Border BackgroundColor="White" StrokeShape="RoundRectangle 32" Stroke="#FFD9C2"
                        StrokeThickness="1.5" WidthRequest="64" HeightRequest="64"
                        HorizontalOptions="End" Margin="0,-32,20,-32" ZIndex="1">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,3" Opacity="0.18" Radius="8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="⭐" FontSize="15" HorizontalOptions="Center"/>
                        <Label Text="{Binding Restaurant.RatingText}" FontFamily="CairoBold" FontSize="12"
                               TextColor="#212121" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Info Card (نفس تصميم المطعم) -->
                <Border x:Name="GroceryInfoCard" BackgroundColor="White" StrokeShape="RoundRectangle 32,32,0,0"
                        Stroke="Transparent" Padding="20,18,20,16"
                        SizeChanged="OnGroceryInfoCardSizeChanged">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Restaurant.Name}" FontFamily="CairoBold" FontSize="22"
                               TextColor="#212121" MaxLines="2" LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding Restaurant.Description}" FontFamily="CairoRegular"
                               FontSize="13" TextColor="#757575"/>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,4,0,0">
                            <HorizontalStackLayout Spacing="8">

                                <Border BackgroundColor="#FFF3EC" StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="12,7">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="🛵" FontSize="12" VerticalOptions="Center"/>
                                        <Label Text="{Binding Restaurant.DeliveryFeeText}" FontFamily="CairoBold" FontSize="13" TextColor="#FF5722" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border BackgroundColor="#FFF3EC" StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="12,7">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="⏱️" FontSize="12" VerticalOptions="Center"/>
                                        <Label Text="{Binding Restaurant.EstimatedTimeText}" FontFamily="CairoBold" FontSize="13" TextColor="#212121" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border BackgroundColor="#FFF3EC" StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="12,7"
                                        IsVisible="{Binding Restaurant.DistanceKm, Converter={StaticResource IntToBool}}">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="📍" FontSize="12" VerticalOptions="Center"/>
                                        <Label Text="{Binding Restaurant.DistanceKm, StringFormat='{0:F1} km'}" FontFamily="CairoBold" FontSize="13" TextColor="#212121" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>

                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#FF5722" Margin="0,16"/>

                <!-- Pharmacy: return to an already-open prescription chat -->
                <Border IsVisible="{Binding HasActivePrescriptionChat}" BackgroundColor="#FFF3E0"
                        StrokeShape="RoundRectangle 14" Stroke="#FFB74D" Margin="16,10,16,0"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{loc:Loc Key=PrescriptionChatOngoingTitle}" FontFamily="CairoBold"
                                   FontSize="14" TextColor="#E65100"/>
                            <Label Text="{loc:Loc Key=PrescriptionChatOngoingHint}" FontFamily="CairoRegular"
                                   FontSize="12" TextColor="#424242"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{loc:Loc Key=ReturnToChat}"
                                Command="{Binding ReturnToPrescriptionChatCommand}"
                                BackgroundColor="#FF5722" TextColor="White"
                                FontFamily="CairoBold" FontSize="13"
                                CornerRadius="10" Padding="14,0" HeightRequest="42"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Pharmacy: upload prescription -->
                <Border IsVisible="{Binding IsPharmacy}" BackgroundColor="#E3F2FD"
                        StrokeShape="RoundRectangle 14" Stroke="#90CAF9" Margin="16,10"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Loc Key=UploadPrescription}" FontFamily="CairoBold"
                               FontSize="16" TextColor="#1565C0"/>
                        <Label Text="{loc:Loc Key=PrescriptionHint}" FontFamily="CairoRegular"
                               FontSize="13" TextColor="#424242"/>
                        <Button Text="{loc:Loc Key=ChoosePrescriptionImage}"
                                Command="{Binding UploadPrescriptionCommand}"
                                BackgroundColor="#1976D2" TextColor="White"
                                FontFamily="CairoBold" CornerRadius="10"/>
                    </VerticalStackLayout>
                </Border>


                <VerticalStackLayout Spacing="10" Margin="16,10,16,4">
                    <Label Text="{loc:Loc Key=ShopByCategoryTitle}" FontFamily="CairoBold" FontSize="17" TextColor="#212121"/>

                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start"
                                BindableLayout.ItemsSource="{Binding FilteredMenu}"
                                BindableLayout.ItemTemplate="{StaticResource CategoryGridTemplate}"/>
                </VerticalStackLayout>

                <!-- الأفضل مبيعًا -->
                <VerticalStackLayout Spacing="10" Margin="16,16,0,20"
                                      IsVisible="{Binding BestSellers.Count, Converter={StaticResource IntToBool}}">
                    <Label Text="{loc:Loc Key=BestSellersTitle}" FontFamily="CairoBold" FontSize="17" TextColor="#212121"/>

                    <CollectionView ItemsSource="{Binding BestSellers}" SelectionMode="None"
                                    ItemsLayout="HorizontalList" ItemTemplate="{StaticResource BestSellerTemplate}"
                                    HeightRequest="233" Margin="0,0,0,4"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="100" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>


        <Border x:Name="StickyCategoriesBar"
                Grid.Row="1"
                VerticalOptions="Start" HorizontalOptions="Fill"
                Margin="0"
                BackgroundColor="White" Stroke="Transparent"
                StrokeShape="Rectangle"
                HeightRequest="150"
                Padding="0,35,0,0"
                IsVisible="False"
                SizeChanged="OnStickyCategoriesBarSizeChanged">
            <!-- يثبت هذا الشريط للأقسام فقط؛ اسم المطعم موجود في الهيدر بين الأيقونتين. -->
            <CollectionView ItemsSource="{Binding Menu}" SelectionMode="None"
                            ItemTemplate="{StaticResource CategoryChipTemplate}"
                            HeightRequest="115" Margin="0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView WidthRequest="16" Color="Transparent"/>
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView WidthRequest="16" Color="Transparent"/>
                </CollectionView.Footer>
            </CollectionView>
        </Border>


        <Border x:Name="CurrentGroupBar"
                Grid.Row="1"
                VerticalOptions="Start" HorizontalOptions="Fill"
                BackgroundColor="#F8F9FA" Stroke="#E0E0E0"
                StrokeShape="Rectangle"
                IsVisible="False">
            <Label x:Name="CurrentGroupNameLabel" FontFamily="CairoBold" FontSize="17"
                   TextColor="#212121" Padding="16,10,16,10" MaxLines="1" LineBreakMode="TailTruncation"/>
        </Border>


        <!-- الهيدر مطابق لباقي صفحات التطبيق: خلفية صلبة بدون أي حدود أو بوردرات جانبية -->
        <Grid x:Name="TopToolbarBar" Grid.Row="0" 
              BackgroundColor="#FF5722"
              HorizontalOptions="Fill" VerticalOptions="Start"
              Padding="0" ZIndex="10">

            <!-- ✅ FIX: زرار الرجوع -->
            <Image x:Name="BackButtonImage" Source="icon_back.png" WidthRequest="38" HeightRequest="38"
                   Margin="16,45,0,0" HorizontalOptions="Start" VerticalOptions="Start">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Image.GestureRecognizers>
            </Image>

            <!-- اسم المطعم في منتصف الهيدر بين زر الرجوع والسلة -->
            <Label x:Name="RestaurantNameHeaderLabel"
                   Text="{Binding Restaurant.Name}"
                   FontFamily="CairoBold" FontSize="14" TextColor="White"
                   HorizontalOptions="Center" VerticalOptions="Start"
                   Margin="60,8,60,0" LineBreakMode="TailTruncation" MaxLines="1"/>

            <!-- أيقونة السلة -->
            <Grid x:Name="CartIconGrid" HorizontalOptions="End" VerticalOptions="Start" Margin="0,45,16,0">
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 19" Stroke="{StaticResource Primary}" StrokeThickness="1.5"
                        WidthRequest="40" HeightRequest="40">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Opacity="0.15" Radius="6"/>
                    </Border.Shadow>
                    <Label Text="🛒" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" >
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCartCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="#F44336" StrokeShape="RoundRectangle 10" Stroke="White"
                        IsVisible="{Binding CartCount, Converter={StaticResource IntToBool}}"
                        WidthRequest="18" HeightRequest="18" HorizontalOptions="End" VerticalOptions="Start">
                    <Label Text="{Binding CartCount}" FontSize="9" FontFamily="CairoBold"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- شريط بحث ثابت داخل نفس الهيدر، مع هامش جانبي واضح -->
            <Border x:Name="SearchBarBorder" Opacity="1" Scale="1" InputTransparent="False"
                    BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0"
                    Margin="16,82,16,0" Padding="12,0" HeightRequest="42"
                    HorizontalOptions="Fill" VerticalOptions="Start">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="4"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="🔍" FontSize="15" VerticalOptions="Center" TextColor="#757575"/>
                    <Entry x:Name="SearchEntry" Grid.Column="1" Text="{Binding SearchQuery}"
                           Placeholder="{loc:Loc Key=SearchInMenu}"
                           FontFamily="CairoRegular" FontSize="13" VerticalOptions="Center"
                           BackgroundColor="Transparent" TextColor="#212121"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Floating View Cart Button -->

        <Border Grid.Row="1"

                BackgroundColor="#FF5722"

                StrokeShape="RoundRectangle 30"

                Stroke="Transparent"

                IsVisible="{Binding CartCount, Converter={StaticResource IntToBool}}"

                Padding="18,13"

                Margin="16,0,16,28"

                VerticalOptions="End">

            <Border.Shadow>

                <Shadow Brush="#FF5722" Offset="0,5" Opacity="0.45" Radius="12"/>

            </Border.Shadow>

            <Border.GestureRecognizers>

                <TapGestureRecognizer Command="{Binding OpenCartCommand}"/>

            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="Auto,*,Auto">

                <Border Grid.Column="0" BackgroundColor="#BF4000" StrokeShape="RoundRectangle 8"

                        Stroke="Transparent" Padding="8,4">

                    <Label Text="{Binding CartCount}" TextColor="White" FontFamily="CairoBold" FontSize="14"/>

                </Border>

                <Label Grid.Column="1" Text="{loc:Loc Key=ViewCart}" TextColor="White"

                       FontFamily="CairoBold" FontSize="16" HorizontalOptions="Center"/>

                <Label Grid.Column="2" Text="→" TextColor="White" FontFamily="CairoBold" FontSize="18"/>

            </Grid>

        </Border>

    </Grid>

</ContentPage>

