<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             xmlns:vm="clr-namespace:DeliveryApp.Customer.ViewModels"

             xmlns:m="clr-namespace:DeliveryApp.Customer.Models"

             xmlns:loc="clr-namespace:DeliveryApp.Customer.Converters"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"

             x:Class="DeliveryApp.Customer.Views.RestaurantPage"

             x:Name="RootPage"

             x:DataType="vm:RestaurantViewModel"

             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <DataTemplate x:Key="CategoryChipTemplate" x:DataType="m:Category">
            <VerticalStackLayout Spacing="4" Padding="10,0" WidthRequest="66" HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryChipTapped" CommandParameter="{Binding .}"/>
                </VerticalStackLayout.GestureRecognizers>

                <!-- ✅ FIX: كانت الأيقونة دايرة كاملة (RoundRectangle 30 على مقاس 60x60
                     = نص القطر = دايرة). دلوقتي مربعة بحواف ناعمة زي باقي الكروت في
                     التطبيق (نفس معامل الانحناء المستخدم في CategoryGridTemplate). -->
                <Border BackgroundColor="#F0F0F0" StrokeShape="RoundRectangle 16"
                        Stroke="#EEEEEE" WidthRequest="60" HeightRequest="60"
                        HorizontalOptions="Center">
                    <Grid>
                        <!-- Fallback -->
                        <Label Text="🍽️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}"/>
                        <!-- Category image -->
                        <ff:CachedImage Source="{Binding FullImageUrl}"
                               Aspect="AspectFill"
                               CacheDuration="7"
                               DownsampleToViewSize="True"
                               HeightRequest="60" WidthRequest="60"
                               IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}}"/>
                    </Grid>
                </Border>

                <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="11"
                       TextColor="#212121" HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation" MaxLines="1"/>

            </VerticalStackLayout>
        </DataTemplate>

        <!-- ✅ FEATURE: كارت قسم في شبكة الأقسام (سوبر ماركت/صيدلية) — الدوس عليه
             يودّي لصفحة منتجات القسم ده لوحده -->
        <DataTemplate x:Key="CategoryGridTemplate" x:DataType="m:Category">
            <Border Style="{StaticResource Card}" Margin="6" Padding="10" WidthRequest="100">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.GoToCategoryCommand}"
                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                            WidthRequest="72" HeightRequest="72">
                        <Grid>
                            <Label Text="🛍️" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}"/>
                            <ff:CachedImage Source="{Binding FullImageUrl}" Aspect="AspectFill"
                                   CacheDuration="7" DownsampleToViewSize="True"
                                   IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}}"/>
                        </Grid>
                    </Border>
                    <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="12" TextColor="#212121"
                           HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!-- ✅ FEATURE + FIX (تصميم مختلف): كارت منتج في صف "الأفضل مبيعًا" —
             دلوقتي بتصميم مميز عن كروت المنتجات العادية: خلفية متدرجة خفيفة، برواز
             برتقالي، وشارة "🔥 الأفضل مبيعًا" فوق الصورة، عشان يبان واضح إن الصف ده
             مختلف عن باقي المنتجات، مع إنه لسه بيتعرض بـ Scroll جانبي (HorizontalList). -->
        <DataTemplate x:Key="BestSellerTemplate" x:DataType="m:Product">
            <Border BackgroundColor="#FFF8F3" StrokeShape="RoundRectangle 14" Stroke="#FFD9C2"
                    StrokeThickness="1.2" WidthRequest="128" Margin="0,4,10,4" Padding="8">
                <Border.Shadow>
                    <Shadow Brush="#FF5722" Offset="0,2" Opacity="0.08" Radius="6"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ProductTappedCommand}"
                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Grid>
                        <Border BackgroundColor="#F0F0F0" StrokeShape="RoundRectangle 10" Stroke="Transparent" HeightRequest="76">
                            <Grid>
                                <Label Text="🔥" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}"/>
                                <ff:CachedImage Source="{Binding FullImageUrl}" Aspect="AspectFill"
                                       CacheDuration="7" DownsampleToViewSize="True"
                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}}"/>
                            </Grid>
                        </Border>

                        <!-- شارة "الأفضل مبيعًا" -->
                        <Border BackgroundColor="#FF5722" StrokeShape="RoundRectangle 6" Stroke="Transparent"
                                HorizontalOptions="Start" VerticalOptions="Start" Margin="4" Padding="5,2">
                            <Label Text="🔥" FontSize="10"/>
                        </Border>

                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#EEEEEE"
                                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-4,-4"
                                WidthRequest="26" HeightRequest="26"
                                IsVisible="{Binding HasVariants, Converter={StaticResource InvertBool}}">
                            <Label Text="+" FontSize="20" FontFamily="CairoBold" TextColor="#FF5722"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.AddToCartCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                    </Grid>
                    <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"/>
                    <Label Text="{Binding PriceText}" FontFamily="CairoBold" FontSize="12" TextColor="#FF5722"/>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- ✅ FIX (جليتش الخلفية أثناء السكرول): مفيش BackgroundColor كان متحدد على
         الـ Grid الرئيسية، فكانت بترجع للون خلفية الصفحة الافتراضي (ممكن يفرق عن
         لون الكارت الأبيض)، وأثناء الـ overscroll/fling السريع كان بيبان "ومضة"
         بلون مختلف تحت الغلاف قبل ما محتوى الكارت الأبيض يوصل مكانه. -->
    <Grid RowDefinitions="220,*" BackgroundColor="White">

        <!-- Cover -->

        <Grid Grid.Row="0" BackgroundColor="#EEEEEE">

            <!-- Fallback placeholder (shown when no cover image) -->
            <Label Text="🍽️" FontSize="80" HorizontalOptions="Center" VerticalOptions="Center"
                   IsVisible="{Binding Restaurant.FullCoverImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}" />

            <!-- Actual restaurant cover image -->
            <ff:CachedImage Source="{Binding Restaurant.FullCoverImageUrl}"
                   Aspect="AspectFill"
                   CacheDuration="7"
                   DownsampleToViewSize="True"
                   IsVisible="{Binding Restaurant.FullCoverImageUrl, Converter={StaticResource HasImage}}" />

            <!-- Back -->

            <Image Source="icon_back.png" WidthRequest="42" HeightRequest="42"
                   Margin="16,45,0,0" HorizontalOptions="Start" VerticalOptions="Start">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Image.GestureRecognizers>
            </Image>

            <!-- Cart -->

            <Grid HorizontalOptions="End" VerticalOptions="Start" Margin="0,48,16,0">

                <Border BackgroundColor="White" StrokeShape="RoundRectangle 22" Stroke="Black"

                        WidthRequest="42" HeightRequest="42">

                    <Label Text="🛒" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center">

                        <Label.GestureRecognizers>

                            <TapGestureRecognizer Command="{Binding OpenCartCommand}"/>

                        </Label.GestureRecognizers>

                    </Label>

                </Border>

                <Border BackgroundColor="#F44336" StrokeShape="RoundRectangle 10" Stroke="Transparent"

                        IsVisible="{Binding CartCount, Converter={StaticResource IntToBool}}"

                        WidthRequest="18" HeightRequest="18" HorizontalOptions="End" VerticalOptions="Start">

                    <Label Text="{Binding CartCount}" FontSize="9" FontFamily="CairoBold"

                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>

                </Border>

            </Grid>

        </Grid>

        <!-- Content -->
        <!-- ✅ FIX (جليتش التداخل مع الغلاف): كان المحتوى بيبدأ من Margin=185 مع إن
             ارتفاع الغلاف 220 — يعني آخر 35px من الغلاف كانت بتتغطى بالكارت الأبيض،
             وده كان بيعمل "تداخل" (glitch) وقت السكرول، لأن صورة الغلاف Cover بتتعرض
             بمكتبة FFImageLoading (ff:CachedImage) اللي بترندر على Surface مستقل عن
             شجرة الـ MAUI العادية على أندرويد، فمش دايمًا بتلتزم بترتيب الطبقات
             (z-order) بتاع العناصر اللي فوقها، فبيظهر "تقطيع"/تداخل مش سموث بدل التراكب
             الناعم المتوقع. الحل: خلينا المحتوى يبدأ بالظبط من نفس ارتفاع الغلاف
             (220) من غير أي تراكب، فمفيش أي جزء من صورة الغلاف بيتغطى بحاجة تانية
             خالص وقت السكرول. -->
        <!-- ✅ FIX (performance): كان ده ScrollView لافّ جواه VerticalStackLayout فيها
             BindableLayout بيولّد CollectionView منفصل لكل كاتيجوري. الـ CollectionView
             جوه ScrollView بيلغي الـ virtualization بتاعته تمامًا، يعني كل المنتجات
             (وكل صورها) في المطعم كله كانت بترندر وتتحمل مرة واحدة من أول ما الصفحة
             تفتح حتى اللي مش ظاهر على الشاشة — وده كان أكبر سبب لتقل صفحة المحل.
             دلوقتي فيه CollectionView واحد بس بـ IsGrouped، فبيعرض بس اللي ظاهر على
             الشاشة وبيعيد استخدام الخلايا (recycling) زي أي تطبيق كبير. -->
        <CollectionView x:Name="MenuCollectionView" Grid.Row="0" Grid.RowSpan="2" Margin="0,220,0,0"
                        ItemsSource="{Binding MenuGroups}" IsGrouped="True" SelectionMode="None"
                        IsVisible="{Binding IsGroceryStoreLayout, Converter={StaticResource InvertBool}}"
                        Scrolled="OnContentScrolled">

            <CollectionView.Header>
            <VerticalStackLayout Spacing="0"   >

                <!-- Info Card -->

                <Border BackgroundColor="White" StrokeShape="RoundRectangle 24,24,0,0"

                        Stroke="Transparent" Padding="20,22,20,16">

                    <VerticalStackLayout Spacing="8">

                        <Label Text="{Binding Restaurant.Name}" FontFamily="CairoBold" FontSize="22" TextColor="#212121"/>

                        <Label Text="{Binding Restaurant.Description}" FontFamily="CairoRegular"

                               FontSize="13" TextColor="#757575"/>

                        <HorizontalStackLayout Spacing="20" Margin="0,6,0,0">

                            <VerticalStackLayout Spacing="1">

                                <Label Text="{loc:Loc Key=Rating}" FontFamily="CairoRegular" FontSize="11" TextColor="#757575"/>

                                <Label Text="{Binding Restaurant.RatingText}" FontFamily="CairoBold" FontSize="16" TextColor="#212121"/>

                            </VerticalStackLayout>

                            <BoxView Color="#E0E0E0" WidthRequest="1" HeightRequest="38"/>

                            <VerticalStackLayout Spacing="1">

                                <Label Text="{loc:Loc Key=DeliveryLabel}" FontFamily="CairoRegular" FontSize="11" TextColor="#757575"/>

                                <Label Text="{Binding Restaurant.DeliveryFeeText}" FontFamily="CairoBold" FontSize="16" TextColor="#FF5722"/>

                            </VerticalStackLayout>

                            <BoxView Color="#E0E0E0" WidthRequest="1" HeightRequest="38"/>

                            <VerticalStackLayout Spacing="1">

                                <Label Text="{loc:Loc Key=EstTime}" FontFamily="CairoRegular" FontSize="11" TextColor="#757575"/>

                                <Label Text="{Binding Restaurant.EstimatedTimeText}" FontFamily="CairoBold" FontSize="16" TextColor="#212121"/>

                            </VerticalStackLayout>

                            <BoxView Color="#E0E0E0" WidthRequest="1" HeightRequest="38" IsVisible="{Binding Restaurant.DistanceKm, Converter={StaticResource IntToBool}}"/>

                            <VerticalStackLayout Spacing="1" IsVisible="{Binding Restaurant.DistanceKm, Converter={StaticResource IntToBool}}">

                                <Label Text="📍" FontFamily="CairoRegular" FontSize="11" TextColor="#757575"/>

                                <Label Text="{Binding Restaurant.DistanceKm, StringFormat='{0:F1} km'}" FontFamily="CairoBold" FontSize="16" TextColor="#212121"/>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#FF5722" Margin="0,16"/>

                <!-- Categories quick-jump bar -->
                <CollectionView x:Name="InlineCategoriesBar" 
                                ItemsSource="{Binding Menu}" SelectionMode="None"
                                IsVisible="{Binding Menu.Count, Converter={StaticResource IntToBool}}"
                                ItemsLayout="HorizontalList"
                                ItemTemplate="{StaticResource CategoryChipTemplate}"
                                HeightRequest="85" Margin="0,10,0,0"
                             
                                BackgroundColor="White" 
                                SizeChanged="OnInlineCategoriesBarSizeChanged"/>

                <!-- Pharmacy: return to an already-open prescription chat -->
                <Border IsVisible="{Binding HasActivePrescriptionChat}" BackgroundColor="#FFF3E0"
                        StrokeShape="RoundRectangle 14" Stroke="#FFB74D" Margin="16,8,16,0"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{loc:Loc Key=PrescriptionChatOngoingTitle}" FontFamily="CairoBold"
                                   FontSize="14" TextColor="#E65100"/>
                            <Label Text="{loc:Loc Key=PrescriptionChatOngoingHint}" FontFamily="CairoRegular"
                                   FontSize="12" TextColor="#424242"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{loc:Loc Key=ReturnToChat}"
                                Command="{Binding ReturnToPrescriptionChatCommand}"
                                BackgroundColor="#FF5722" TextColor="White"
                                FontFamily="CairoBold" FontSize="13"
                                CornerRadius="10" Padding="14,0" HeightRequest="42"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Pharmacy: upload prescription -->
                <Border IsVisible="{Binding IsPharmacy}" BackgroundColor="#E3F2FD"
                        StrokeShape="RoundRectangle 14" Stroke="#90CAF9" Margin="16,8"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Loc Key=UploadPrescription}" FontFamily="CairoBold"
                               FontSize="16" TextColor="#1565C0"/>
                        <Label Text="{loc:Loc Key=PrescriptionHint}" FontFamily="CairoRegular"
                               FontSize="13" TextColor="#424242"/>
                        <Button Text="{loc:Loc Key=ChoosePrescriptionImage}"
                                Command="{Binding UploadPrescriptionCommand}"
                                BackgroundColor="#1976D2" TextColor="White"
                                FontFamily="CairoBold" CornerRadius="10"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Menu Categories: كل عنصر جوه IsGrouped=True فبيتعرض بس وقت ما يظهر
                 فعليًا على الشاشة (recycling)، مش كله مرة واحدة زي قبل كده -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Key.Name}" FontFamily="CairoBold" FontSize="17"
                           TextColor="#212121" BackgroundColor="#F8F9FA"
                           Padding="16,18,16,2"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

                                <CollectionView.ItemTemplate>

                                        <DataTemplate x:DataType="m:Product">

                                            <Border Style="{StaticResource Card}" Margin="16,0,16,10">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ProductTappedCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,84" ColumnSpacing="12">

                                                    <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">

                                                        <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="14" TextColor="#212121"/>

                                                        <Label Text="{Binding Description}" FontFamily="CairoRegular"

                                                               FontSize="12" TextColor="#757575" MaxLines="2" LineBreakMode="TailTruncation"/>

                                                        <HorizontalStackLayout Spacing="8">

                                                            <Label Text="{Binding PriceText}" FontFamily="CairoBold"

                                                                   FontSize="15" TextColor="#FF5722"/>

                                                            <Label Text="{Binding OriginalPriceText}" FontFamily="CairoRegular"

                                                                   FontSize="12" TextColor="#BDBDBD"

                                                                   IsVisible="{Binding HasDiscount}"

                                                                   TextDecorations="Strikethrough"/>

                                                        </HorizontalStackLayout>

                                                    </VerticalStackLayout>

                                                    <Grid Grid.Column="1">

                                                        <Border BackgroundColor="#F0F0F0" StrokeShape="RoundRectangle 10"
                                                                Stroke="Transparent" HeightRequest="84">
                                                            <Grid>
                                                                <!-- Placeholder emoji -->
                                                                <Label Text="🍛" FontSize="36"
                                                                       HorizontalOptions="Center" VerticalOptions="Center"
                                                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}" />
                                                                <!-- Actual product image -->
                                                                <ff:CachedImage Source="{Binding FullImageUrl}"
                                                                       Aspect="AspectFill"
                                                                       HeightRequest="84" WidthRequest="84"
                                                                       CacheDuration="7"
                                                                       DownsampleToViewSize="True"
                                                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}}" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- Add / customize -->
                                                        <Image Source="icon_plus.png" WidthRequest="34" HeightRequest="34"
                                                               HorizontalOptions="End" VerticalOptions="End"
                                                               IsVisible="{Binding HasVariants, Converter={StaticResource InvertBool}}">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.AddToCartCommand}"
                                                                    CommandParameter="{Binding .}"/>
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                        <Label Text="›" FontSize="28" TextColor="#FF5722"
                                                               HorizontalOptions="End" VerticalOptions="End"
                                                               IsVisible="{Binding HasVariants}"/>

                                                    </Grid>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="Transparent"/>
            </CollectionView.Footer>

        </CollectionView>

        <!-- ✅ FEATURE: تصميم السوبر ماركت/الصيدلية — شبكة أقسام بدل القايمة الكاملة.
             الدوس على أي قسم يودّي لصفحة منتجات القسم لوحده (فلترة/فرز + اقتراحات). -->
        <!-- ✅ FIX: مضاف Scrolled عشان اسم المحل يعوم فوق (Sticky) لما نعمل اسكرول
             هنا برضو بالظبط زي صفحة المطعم العادية — قبل كده مكنش فيه أي wiring
             للسكرول في اللاي أوت ده فالشريط العايم كان بيفضل مختفي طول الوقت. -->
        <ScrollView x:Name="GroceryScrollView" Grid.Row="0" Grid.RowSpan="2" Margin="0,220,0,0"
                    IsVisible="{Binding IsGroceryStoreLayout}" Scrolled="OnGroceryScrolled">
            <VerticalStackLayout Spacing="0">

                <!-- Info Card (نفس تصميم المطعم) -->
                <Border x:Name="GroceryInfoCard" BackgroundColor="White" StrokeShape="RoundRectangle 24,24,0,0"
                        Stroke="Transparent" Padding="20,22,20,16"
                        SizeChanged="OnGroceryInfoCardSizeChanged">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Restaurant.Name}" FontFamily="CairoBold" FontSize="22" TextColor="#212121"/>
                        <Label Text="{Binding Restaurant.Description}" FontFamily="CairoRegular"
                               FontSize="13" TextColor="#757575"/>
                        <HorizontalStackLayout Spacing="20" Margin="0,6,0,0">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{loc:Loc Key=Rating}" FontFamily="CairoRegular" FontSize="11" TextColor="#757575"/>
                                <Label Text="{Binding Restaurant.RatingText}" FontFamily="CairoBold" FontSize="16" TextColor="#212121"/>
                            </VerticalStackLayout>
                            <BoxView Color="#E0E0E0" WidthRequest="1" HeightRequest="38"/>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{loc:Loc Key=DeliveryLabel}" FontFamily="CairoRegular" FontSize="11" TextColor="#757575"/>
                                <Label Text="{Binding Restaurant.DeliveryFeeText}" FontFamily="CairoBold" FontSize="16" TextColor="#FF5722"/>
                            </VerticalStackLayout>
                            <BoxView Color="#E0E0E0" WidthRequest="1" HeightRequest="38"/>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{loc:Loc Key=EstTime}" FontFamily="CairoRegular" FontSize="11" TextColor="#757575"/>
                                <Label Text="{Binding Restaurant.EstimatedTimeText}" FontFamily="CairoBold" FontSize="16" TextColor="#212121"/>
                            </VerticalStackLayout>

                            <!-- ✅ FIX: كارت المعلومات بتاع السوبر ماركت/الصيدلية كان
                                 ناقصه عمود المسافة اللي موجود في نفس الكارت بتاع المطعم
                                 العادي (اتنسخ من فوق) -->
                            <BoxView Color="#E0E0E0" WidthRequest="1" HeightRequest="38" IsVisible="{Binding Restaurant.DistanceKm, Converter={StaticResource IntToBool}}"/>
                            <VerticalStackLayout Spacing="1" IsVisible="{Binding Restaurant.DistanceKm, Converter={StaticResource IntToBool}}">
                                <Label Text="📍" FontFamily="CairoRegular" FontSize="11" TextColor="#757575"/>
                                <Label Text="{Binding Restaurant.DistanceKm, StringFormat='{0:F1} km'}" FontFamily="CairoBold" FontSize="16" TextColor="#212121"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#FF5722" Margin="0,16"/>

                <!-- Pharmacy: return to an already-open prescription chat -->
                <Border IsVisible="{Binding HasActivePrescriptionChat}" BackgroundColor="#FFF3E0"
                        StrokeShape="RoundRectangle 14" Stroke="#FFB74D" Margin="16,10,16,0"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{loc:Loc Key=PrescriptionChatOngoingTitle}" FontFamily="CairoBold"
                                   FontSize="14" TextColor="#E65100"/>
                            <Label Text="{loc:Loc Key=PrescriptionChatOngoingHint}" FontFamily="CairoRegular"
                                   FontSize="12" TextColor="#424242"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{loc:Loc Key=ReturnToChat}"
                                Command="{Binding ReturnToPrescriptionChatCommand}"
                                BackgroundColor="#FF5722" TextColor="White"
                                FontFamily="CairoBold" FontSize="13"
                                CornerRadius="10" Padding="14,0" HeightRequest="42"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Pharmacy: upload prescription -->
                <Border IsVisible="{Binding IsPharmacy}" BackgroundColor="#E3F2FD"
                        StrokeShape="RoundRectangle 14" Stroke="#90CAF9" Margin="16,10"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Loc Key=UploadPrescription}" FontFamily="CairoBold"
                               FontSize="16" TextColor="#1565C0"/>
                        <Label Text="{loc:Loc Key=PrescriptionHint}" FontFamily="CairoRegular"
                               FontSize="13" TextColor="#424242"/>
                        <Button Text="{loc:Loc Key=ChoosePrescriptionImage}"
                                Command="{Binding UploadPrescriptionCommand}"
                                BackgroundColor="#1976D2" TextColor="White"
                                FontFamily="CairoBold" CornerRadius="10"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ✅ FIX (ترتيب): شبكة الأقسام دلوقتي فوق، وتحتها على طول قسم
                     "الأفضل مبيعًا" (كان قبل كده الأفضل مبيعًا فوق الأقسام). عدد الأقسام
                     في المحل الواحد محدود، فـ FlexLayout بيتحجم تلقائيًا حسب المحتوى
                     جوه الـ ScrollView من غير مشكلة الـ CollectionView اللي محتاجة
                     HeightRequest ثابت (المشكلة دي بالظبط اللي خلتنا نتجنبها مع
                     المنتجات في صفحة المطعم العادية). -->
                <VerticalStackLayout Spacing="10" Margin="16,10,16,4">
                    <Label Text="{loc:Loc Key=ShopByCategoryTitle}" FontFamily="CairoBold" FontSize="17" TextColor="#212121"/>
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start"
                                BindableLayout.ItemsSource="{Binding Menu}"
                                BindableLayout.ItemTemplate="{StaticResource CategoryGridTemplate}"/>
                </VerticalStackLayout>

                <!-- الأفضل مبيعًا -->
                <VerticalStackLayout Spacing="10" Margin="16,16,0,20"
                                      IsVisible="{Binding BestSellers.Count, Converter={StaticResource IntToBool}}">
                    <Label Text="{loc:Loc Key=BestSellersTitle}" FontFamily="CairoBold" FontSize="17" TextColor="#212121"/>
                    <CollectionView ItemsSource="{Binding BestSellers}" SelectionMode="None"
                                    ItemsLayout="HorizontalList" ItemTemplate="{StaticResource BestSellerTemplate}"
                                    HeightRequest="160" Margin="0,0,0,4"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="100" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- نسخة عايمة (Sticky) من شريط الكاتوجريز — بتظهر بس لما اليوزر ينزل
             وتوصل النسخة الأصلية لحافة الاسكرول، فبيبان كأنه لزق فوق.
             ✅ FIX: مضاف اسم المحل هنا فوق شريط الأقسام، عشان لما يعمل اليوزر
             اسكرول لتحت، اسم المحل يفضل ظاهر فوق بدل ما يختفي مع الغلاف. -->
        <Border x:Name="StickyCategoriesBar"
                Grid.Row="0" Grid.RowSpan="2"
                VerticalOptions="Start" HorizontalOptions="Fill"
                Margin="0,220,0,0"
                BackgroundColor="White" Stroke="Transparent"
                StrokeShape="Rectangle"
                IsVisible="False">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Opacity="0.10" Radius="6"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="0">
                <Label Text="{Binding Restaurant.Name}" FontFamily="CairoBold" FontSize="15"
                       TextColor="#212121" Margin="16,10,16,0" MaxLines="1" LineBreakMode="TailTruncation"/>
                <CollectionView ItemsSource="{Binding Menu}" SelectionMode="None"
                                ItemsLayout="HorizontalList"
                                ItemTemplate="{StaticResource CategoryChipTemplate}"
                                HeightRequest="86" Margin="0,4,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Floating View Cart Button -->

        <Border Grid.Row="1"

                BackgroundColor="#FF5722"

                StrokeShape="RoundRectangle 16"

                Stroke="Transparent"

                IsVisible="{Binding CartCount, Converter={StaticResource IntToBool}}"

                Padding="18,13"

                Margin="16,0,16,28"

                VerticalOptions="End">

            <Border.Shadow>

                <Shadow Brush="#FF5722" Offset="0,5" Opacity="0.45" Radius="12"/>

            </Border.Shadow>

            <Border.GestureRecognizers>

                <TapGestureRecognizer Command="{Binding OpenCartCommand}"/>

            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="Auto,*,Auto">

                <Border Grid.Column="0" BackgroundColor="#BF4000" StrokeShape="RoundRectangle 8"

                        Stroke="Transparent" Padding="8,4">

                    <Label Text="{Binding CartCount}" TextColor="White" FontFamily="CairoBold" FontSize="14"/>

                </Border>

                <Label Grid.Column="1" Text="{loc:Loc Key=ViewCart}" TextColor="White"

                       FontFamily="CairoBold" FontSize="16" HorizontalOptions="Center"/>

                <Label Grid.Column="2" Text="→" TextColor="White" FontFamily="CairoBold" FontSize="18"/>

            </Grid>

        </Border>

    </Grid>

</ContentPage>

