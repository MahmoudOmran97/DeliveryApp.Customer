<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeliveryApp.Customer.ViewModels"
             xmlns:loc="clr-namespace:DeliveryApp.Customer.Converters"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="DeliveryApp.Customer.Views.OrderTrackingPage"
             x:DataType="vm:OrderTrackingViewModel"
             Shell.NavBarIsVisible="False">

    <!-- لوحة سفلية أعلى وأكثر وضوحاً؛ بطاقة المندوب تظهر في بداية المحتوى -->
    <Grid RowDefinitions="*,390">

        <!-- Map Control -->
        <mapsui:MapControl x:Name="MapControl" Grid.Row="0" />

        <!-- Back Button -->
        <Border BackgroundColor="White" StrokeShape="RoundRectangle 22" Stroke="Transparent"
                WidthRequest="44" HeightRequest="44" Margin="16,52,0,0"
                HorizontalOptions="Start" VerticalOptions="Start">
            <Image Source="icon_back.png" WidthRequest="30" HeightRequest="30"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Image.GestureRecognizers>
            </Image>
        </Border>

        <!-- ETA and Distance Badge -->
        <Border BackgroundColor="#EEFFFFFF" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                Padding="12,8" Margin="16,110,0,0"
                HorizontalOptions="Start" VerticalOptions="Start">
            <HorizontalStackLayout Spacing="10">
                <VerticalStackLayout>
                    <Label Text="{loc:Loc Key=ETA}"
                           FontSize="10" FontFamily="CairoRegular" TextColor="#757575"/>
                    <Label Text="{Binding TravelTime}"
                           FontSize="14" FontFamily="CairoBold" TextColor="#212121"/>
                </VerticalStackLayout>
                <BoxView Color="#E0E0E0" WidthRequest="1" VerticalOptions="Fill"/>
                <VerticalStackLayout>
                    <Label Text="{loc:Loc Key=Distance}"
                           FontSize="10" FontFamily="CairoRegular" TextColor="#757575"/>
                    <Label Text="{Binding Distance}"
                           FontSize="14" FontFamily="CairoBold" TextColor="#212121"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <!-- Map Legend -->
        <Border BackgroundColor="#EEFFFFFF" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                Padding="10,8" Margin="0,52,12,0"
                HorizontalOptions="End" VerticalOptions="End">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="8">
                    <Image Source="marker_user" WidthRequest="20" HeightRequest="20"/>
                    <Label Text="{loc:Loc Key=LegendYou}"
                           FontSize="11" FontFamily="CairoRegular" TextColor="#212121" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Image Source="marker_shop" WidthRequest="20" HeightRequest="20"/>
                    <Label Text="{loc:Loc Key=LegendRestaurant}"
                           FontSize="11" FontFamily="CairoRegular" TextColor="#212121" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Image Source="marker_driver" WidthRequest="20" HeightRequest="20"/>
                    <Label Text="{loc:Loc Key=LegendDelivery}"
                           FontSize="11" FontFamily="CairoRegular" TextColor="#212121" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Info Panel -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeShape="RoundRectangle 26,26,0,0" Stroke="Transparent">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Opacity="0.1" Radius="16"/>
            </Border.Shadow>
            <ScrollView>
                <VerticalStackLayout Padding="22,18" Spacing="16">
                    <BoxView BackgroundColor="#E0E0E0" HeightRequest="4" WidthRequest="44"
                             HorizontalOptions="Center" CornerRadius="2"/>
                    <Label Text="{Binding StatusMsg}" FontFamily="CairoBold" FontSize="17"
                           TextColor="#212121" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="#FF5722"
                                 BackgroundColor="#EEEEEE" HeightRequest="8"/>

                    <!-- Driver Info: مثبت في بداية لوحة التتبع حتى يظهر فوراً بدون Scroll -->
                    <Border BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 14"
                            Stroke="Transparent" Padding="12" IsVisible="{Binding HasDriver}">
                        <Grid ColumnDefinitions="48,*,42,42" ColumnSpacing="6">
                            <Border Grid.Column="0" BackgroundColor="#FF5722" StrokeShape="RoundRectangle 24"
                                    Stroke="Transparent" WidthRequest="48" HeightRequest="48">
                                <Label Text="🚴" FontSize="23" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="6,0,3,0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Order.Driver.Name}"
                                       FontFamily="CairoBold" FontSize="13" TextColor="#212121"
                                       LineBreakMode="TailTruncation" MaxLines="1"/>
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="⭐" FontSize="10" VerticalOptions="Center"/>
                                    <Label Text="{Binding Order.Driver.Rating, StringFormat='{0:F1}'}"
                                           FontFamily="CairoRegular" FontSize="11" TextColor="#757575"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="#FFF3E0" StrokeShape="RoundRectangle 21"
                                    Stroke="Transparent" WidthRequest="42" HeightRequest="42">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenChatCommand}"/>
                                </Border.GestureRecognizers>
                                <Label Text="💬" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="3" BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 21"
                                    Stroke="Transparent" WidthRequest="42" HeightRequest="42">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CallDriverCommand}"/>
                                </Border.GestureRecognizers>
                                <Label Text="📞" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Modern Countdown Cards -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasCountdownPanel}">
                        <!-- Store preparation countdown -->
                        <Border IsVisible="{Binding IsPrepTimerVisible}"
                                BackgroundColor="#FFF7F2" Stroke="#FFE0D2"
                                StrokeShape="RoundRectangle 18" Padding="16,14">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="9">
                                <HorizontalStackLayout Grid.Row="0" Spacing="9">
                                    <Border BackgroundColor="#FF5722" Stroke="Transparent"
                                            StrokeShape="RoundRectangle 13" WidthRequest="38" HeightRequest="38">
                                        <Label Text="📦" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                        <Label Text="{loc:Loc Key=Timer_PreparingTitle}"
                                               FontFamily="CairoBold" FontSize="13" TextColor="#2D2521"/>
                                        <Label Text="{Binding PrepTimerHint}"
                                               FontFamily="CairoRegular" FontSize="10" TextColor="#8D7770"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Grid.Row="0" Text="{Binding PrepCountdownText}"
                                       FontFamily="CairoBold" FontSize="23" TextColor="#FF5722"
                                       VerticalOptions="Center"/>
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="{Binding PrepTimerProgress}"
                                             ProgressColor="#FF5722" BackgroundColor="#FFE5DB" HeightRequest="6"/>
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{loc:Loc Key=Timer_CountdownHint}"
                                       FontFamily="CairoRegular" FontSize="10" TextColor="#9C8880"/>
                            </Grid>
                        </Border>

                        <!-- Delivery countdown -->
                        <Border IsVisible="{Binding IsDeliveryTimerVisible}"
                                BackgroundColor="#F2F8FF" Stroke="#D8E9FF"
                                StrokeShape="RoundRectangle 18" Padding="16,14">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="9">
                                <HorizontalStackLayout Grid.Row="0" Spacing="9">
                                    <Border BackgroundColor="#1976D2" Stroke="Transparent"
                                            StrokeShape="RoundRectangle 13" WidthRequest="38" HeightRequest="38">
                                        <Label Text="🛵" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                        <Label Text="{loc:Loc Key=Timer_DeliveryTitle}"
                                               FontFamily="CairoBold" FontSize="13" TextColor="#1F2A35"/>
                                        <Label Text="{Binding DeliveryTimerHint}"
                                               FontFamily="CairoRegular" FontSize="10" TextColor="#71859A"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Grid.Row="0" Text="{Binding DeliveryCountdownText}"
                                       FontFamily="CairoBold" FontSize="23" TextColor="#1976D2"
                                       VerticalOptions="Center"/>
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="{Binding DeliveryTimerProgress}"
                                             ProgressColor="#1976D2" BackgroundColor="#DDEEFF" HeightRequest="6"/>
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{loc:Loc Key=Timer_CountdownHint}"
                                       FontFamily="CairoRegular" FontSize="10" TextColor="#8295A8"/>
                            </Grid>
                        </Border>

                        <!-- Waiting for driver -->
                        <Border IsVisible="{Binding IsWaitingDriverVisible}"
                                BackgroundColor="#FFF9E8" Stroke="#F8E5A8"
                                StrokeShape="RoundRectangle 18" Padding="16,14">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="⏳" FontSize="24" VerticalOptions="Center"/>
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="{loc:Loc Key=Timer_WaitingTitle}"
                                           FontFamily="CairoBold" FontSize="13" TextColor="#5C4810"/>
                                    <Label Text="{Binding WaitingDriverText}"
                                           FontFamily="CairoRegular" FontSize="10" TextColor="#8D7629"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Steps Indicator -->
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="3">
                            <Label Text="📋" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{loc:Loc Key=Step_Order}"
                                   FontFamily="CairoRegular" FontSize="10" TextColor="#757575" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="3">
                            <Label Text="✅" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{loc:Loc Key=Step_Accept}"
                                   FontFamily="CairoRegular" FontSize="10" TextColor="#757575" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="3">
                            <Label Text="📦" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{loc:Loc Key=Step_Prepare}"
                                   FontFamily="CairoRegular" FontSize="10" TextColor="#757575" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="3">
                            <Label Text="🛵" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{loc:Loc Key=Step_OnRoute}"
                                   FontFamily="CairoRegular" FontSize="10" TextColor="#757575" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="3">
                            <Label Text="🎉" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{loc:Loc Key=Step_Arrived}"
                                   FontFamily="CairoRegular" FontSize="10" TextColor="#757575" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Cancel Order Button — يظهر بس قبل بدء التحضير (Pending/Accepted) -->
                    <Button Text="{loc:Loc Key=CancelOrder}"
                            Command="{Binding CancelOrderCommand}"
                            IsVisible="{Binding Order.CanCancel}"
                            BackgroundColor="#FFF3EF" TextColor="#F44336"
                            FontFamily="CairoBold" FontSize="14"
                            CornerRadius="12" HeightRequest="46"/>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
