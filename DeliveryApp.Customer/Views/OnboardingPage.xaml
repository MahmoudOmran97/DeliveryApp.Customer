<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DeliveryApp.Customer.Models"
             xmlns:loc="clr-namespace:DeliveryApp.Customer.Converters"
             x:Class="DeliveryApp.Customer.Views.OnboardingPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <!-- ✅ شاشات تعريفية (Onboarding) — بتتعرض مرة واحدة بس أول ما العميل
         يسطّب التطبيق ويفتحه لأول مرة (شوف OnboardingPage.xaml.cs +
         SplashPage.xaml.cs لمنطق "مرة واحدة بس" باستخدام Preferences). -->
    <Grid RowDefinitions="*,Auto">

        <!-- ═══════ محتوى السلايدات ═══════ -->
        <Grid Grid.Row="0">

            <!-- الموجة السفلية (كحلي + برتقالي) خلف المحتوى، ثابتة عبر السلايدات -->
            <Grid VerticalOptions="End" HeightRequest="110" InputTransparent="True">
                <BoxView Color="{StaticResource TalyNavy}"
                         HeightRequest="50"
                         VerticalOptions="End" />
                <Path Data="M0,40 C 90,85 260,0 400,45 L400,110 L0,110 Z"
                      Fill="{StaticResource Primary}"
                      Aspect="Fill"
                      HorizontalOptions="Fill"
                      HeightRequest="90"
                      VerticalOptions="End" />
            </Grid>

            <CarouselView x:Name="Carousel"
                          Loop="False"
                          IndicatorView="PageIndicator"
                          PositionChanged="Carousel_PositionChanged"
                          VerticalOptions="Fill">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="models:OnboardingSlide">
                        <ScrollView>
                            <VerticalStackLayout Padding="28,26,28,16" Spacing="0" HorizontalOptions="Fill">

                                <!-- شعار Taly (البادچ الكحلي جوه الصورة نفسها) -->
                                <Image Source="logo_ar.png"
                                       WidthRequest="100" HeightRequest="100"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center" />

                                <Label Text="{Binding Title}"
                                       FontFamily="CairoBold" FontSize="21"
                                       TextColor="{StaticResource TalyNavy}"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,14,0,0" />

                                <Label Text="{Binding Subtitle}"
                                       FontFamily="CairoRegular" FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,8,0,0" />

                                <!-- ═══ صورة السلايد (من الصور التسويقية الجاهزة) ═══ -->
                                <Image Source="{Binding Image}"
                                       Aspect="AspectFit"
                                       HeightRequest="260"
                                       HorizontalOptions="Fill"
                                       Margin="0,20,0,0" />

                            </VerticalStackLayout>
                        </ScrollView>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </Grid>

        <!-- ═══════ الفوتر: النقط + زرار التالي/ابدأ ═══════ -->
        <Grid Grid.Row="1" Padding="24,8,24,36" ColumnDefinitions="Auto,*">

            <Border Grid.Column="0" StrokeShape="RoundRectangle 24" Stroke="Transparent"
                    BackgroundColor="{StaticResource Primary}"
                    Padding="22,12" HorizontalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNextTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <Label x:Name="NextButtonLabel"
                           Text="{loc:Loc Key=Onboarding_Next}"
                           FontFamily="CairoBold" FontSize="15" TextColor="White"
                           VerticalOptions="Center" />
                    <Label Text="→" FontSize="16" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <IndicatorView x:Name="PageIndicator"
                           Grid.Column="1"
                           HorizontalOptions="Start" VerticalOptions="Center"
                           Margin="18,0,0,0"
                           IndicatorSize="8"
                           IndicatorColor="{StaticResource Divider}"
                           SelectedIndicatorColor="{StaticResource Primary}" />
        </Grid>

    </Grid>
</ContentPage>
