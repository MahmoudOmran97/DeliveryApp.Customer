<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeliveryApp.Customer.ViewModels"
             xmlns:m="clr-namespace:DeliveryApp.Customer.Models"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:loc="clr-namespace:DeliveryApp.Customer.Converters"
             xmlns:controls="clr-namespace:DeliveryApp.Customer.Controls"
             x:Class="DeliveryApp.Customer.Views.StoreCategoryProductsPage"
             x:Name="RootPage"
             x:DataType="vm:StoreCategoryProductsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>

        <!-- شريط الأقسام العلوي -->
        <DataTemplate x:Key="CategoryChipTemplate" x:DataType="m:Category">
            <Border BackgroundColor="{Binding IsSelectedForChip, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FF5722|#F0F0F0'}"
                    StrokeShape="RoundRectangle 20" Stroke="Transparent"
                    Padding="16,9" Margin="4,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectCategoryCommand}"
                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>
                <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="13"
                       TextColor="{Binding IsSelectedForChip, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#424242'}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProductGridTemplate" x:DataType="m:Product">
            <Border BackgroundColor="White" Stroke="#ECEEF2" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20" Margin="5,6" Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#1A000000" Offset="0,3" Opacity="0.10" Radius="12"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ProductTappedCommand}"
                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>

                <Grid RowDefinitions="138,Auto,Auto,Auto" Padding="0,0,10,10">
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Border BackgroundColor="#F5F6FA" Stroke="Transparent"
                                StrokeShape="RoundRectangle 20,20,0,0">
                            <Grid>
                                <Label Text="🛒" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}"/>
                                <ff:CachedImage Source="{Binding FullImageUrl}" Aspect="AspectFill"
                                       CacheDuration="7" DownsampleToViewSize="True"
                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}}"/>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding IsBestSeller}" BackgroundColor="#FF9800"
                                StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                HorizontalOptions="Start" VerticalOptions="Start" Margin="8"
                                Padding="7,3">
                            <Label Text="{loc:Loc Key=BestSellerBadge}" FontFamily="CairoBold"
                                   FontSize="9" TextColor="White"/>
                        </Border>

                            <ImageButton Source="icon_plus.png" Aspect="AspectFit"
                                 WidthRequest="50" HeightRequest="50"
                                CornerRadius="20" Padding="3" HorizontalOptions="End" VerticalOptions="End"
                                Margin="0,0,10,-8"
                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.AddToCartCommand}"
                                CommandParameter="{Binding .}"
                                IsVisible="{Binding HasVariants, Converter={StaticResource InvertBool}}"/>
                    </Grid>

                    <Label Grid.Row="1" Text="{Binding Name}" FontFamily="CairoBold" FontSize="13"
                           TextColor="#202124" MaxLines="1" LineBreakMode="TailTruncation"
                           Margin="10,0,0,0"/>

                    <HorizontalStackLayout Grid.Row="2" Spacing="6" Margin="10,3,0,0">
                        <Label Text="{Binding PriceText}" FontFamily="CairoBold" FontSize="14" TextColor="#FF5722"/>
                        <Label Text="{Binding OriginalPriceText}" FontFamily="CairoRegular" FontSize="11"
                               TextColor="#A8ACB4" TextDecorations="Strikethrough"
                               IsVisible="{Binding HasDiscount}"/>
                    </HorizontalStackLayout>

                    <Border Grid.Row="3" BackgroundColor="#FFF3EC" Stroke="Transparent"
                            StrokeShape="RoundRectangle 10" HeightRequest="32" Margin="10,7,0,0"
                            IsVisible="{Binding HasVariants}">
                        <Label Text="{loc:Loc Key=Customizable}" FontFamily="CairoBold" FontSize="11"
                               TextColor="#FF5722" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </ContentPage.Resources>

    <!-- ✅ FIX (تداخل/قصّ شريط الأقسام مع شريط الفلاتر): كان الصفين التانيين
         "Auto" الارتفاع، وارتفاع الـ Auto لـ CollectionView على أندرويد مش
         دايمًا بيتقاس صح في أول Layout pass (خصوصًا قبل ما العناصر تتحمل)،
         فكان أحيانًا بيتحسب بارتفاع أصغر من المفروض وبالتالي الصف اللي بعده
         (الفلاتر) بيتحرك لفوق ويتراكب/يتقطع فوق شريط الأقسام. الحل: ارتفاع
         ثابت للصفين بدل Auto، بقيمة أكبر شوية من المحتوى الفعلي (52 و ~46)
         عشان تضمن مساحة كافية دايمًا. -->
    <Grid RowDefinitions="Auto,76,62,*">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="#FF5722" Stroke="Transparent"
                StrokeShape="RoundRectangle 0,0,0,24" Padding="20,52,20,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ImageButton Grid.Column="0" Source="icon_back.png" WidthRequest="38" HeightRequest="38"
                             BackgroundColor="Transparent" VerticalOptions="Center" Command="{Binding GoBackCommand}"/>
                <Label Grid.Column="1" Text="{Binding SelectedCategory.Name}" FontFamily="CairoBold" FontSize="19"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 22"
                            Stroke="Transparent" WidthRequest="44" HeightRequest="44">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCartCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="🛒" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border BackgroundColor="#F44336" StrokeShape="RoundRectangle 10"
                            Stroke="White" StrokeThickness="1" IsVisible="{Binding CartCount, Converter={StaticResource IntToBool}}"
                            WidthRequest="20" HeightRequest="20" HorizontalOptions="End" VerticalOptions="Start">
                        <Label Text="{Binding CartCount}" FontSize="10" FontFamily="CairoBold"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- شريط الأقسام العصري -->
        <Border Grid.Row="1" Margin="12,10,12,4" Padding="4,6" BackgroundColor="White"
                Stroke="#ECEEF2" StrokeThickness="1" StrokeShape="RoundRectangle 18">
            <Border.Shadow>
                <Shadow Brush="#1A000000" Offset="0,2" Opacity="0.08" Radius="8"/>
            </Border.Shadow>
            <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None"
                            ItemsLayout="HorizontalList" ItemTemplate="{StaticResource CategoryChipTemplate}"
                            HeightRequest="58" BackgroundColor="Transparent"/>
        </Border>

        <!-- شريط الفرز والفلترة العصري والقابل للتمرير -->
        <Border Grid.Row="2" Margin="12,4,12,6" Padding="4,3" BackgroundColor="White"
                Stroke="#ECEEF2" StrokeThickness="1" StrokeShape="RoundRectangle 16">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">

            <Border BackgroundColor="{Binding IsSortBest, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FF5722|#F0F0F0'}"
                    StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="12,7">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetSortCommand}" CommandParameter="best"/>
                </Border.GestureRecognizers>
                <Label Text="{loc:Loc Key=SortBestSeller}" FontFamily="CairoBold" FontSize="12"
                       TextColor="{Binding IsSortBest, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#424242'}"/>
            </Border>

            <Border BackgroundColor="{Binding IsSortPriceAsc, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FF5722|#F0F0F0'}"
                    StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="12,7">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetSortCommand}" CommandParameter="priceAsc"/>
                </Border.GestureRecognizers>
                <Label Text="{loc:Loc Key=SortPriceAsc}" FontFamily="CairoBold" FontSize="12"
                       TextColor="{Binding IsSortPriceAsc, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#424242'}"/>
            </Border>

            <Border BackgroundColor="{Binding IsSortPriceDesc, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FF5722|#F0F0F0'}"
                    StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="12,7">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetSortCommand}" CommandParameter="priceDesc"/>
                </Border.GestureRecognizers>
                <Label Text="{loc:Loc Key=SortPriceDesc}" FontFamily="CairoBold" FontSize="12"
                       TextColor="{Binding IsSortPriceDesc, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#424242'}"/>
            </Border>

            <Border BackgroundColor="{Binding DiscountOnly, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FF5722|#F0F0F0'}"
                    StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="12,7">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDiscountOnlyCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="{loc:Loc Key=DiscountOnly}" FontFamily="CairoBold" FontSize="12"
                       TextColor="{Binding DiscountOnly, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#424242'}"/>
            </Border>

            </HorizontalStackLayout>
            </ScrollView>
        </Border>

        <!-- شبكة المنتجات -->
        <Grid Grid.Row="3">

            <CollectionView ItemsSource="{Binding DisplayedProducts}" SelectionMode="None"
                            ItemTemplate="{StaticResource ProductGridTemplate}"
                            BackgroundColor="#F6F7FB">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2"/>
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="100" Color="Transparent"/>
                </CollectionView.Footer>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="#FF5722" VerticalOptions="Center"/>

            <VerticalStackLayout IsVisible="{Binding HasNoProducts}" VerticalOptions="Center"
                                  HorizontalOptions="Center" Spacing="8">
                <Label Text="🔎" FontSize="40" HorizontalOptions="Center"/>
                <Label Text="{loc:Loc Key=NoProductsFound}" FontFamily="CairoRegular" FontSize="14" TextColor="#757575"/>
            </VerticalStackLayout>

            <!-- شريط اقتراحات "بيتطلب مع" -->
            <!-- ✅ FIX: الكارت كان بيتقطع من تحت (زرار "إضافة" مش ظاهر) لسببين:
                 1) الـ CollectionView كانت مساحتها (150) أصغر من محتوى الكارت الفعلي
                    (صورة 70 + اسم + سعر + زرار 28 + الـ Spacing/Padding) بيوصلوا لحوالي 180.
                 2) مفيش أي هامش سفلي بياخد باله من الـ Safe Area / أزرار النافيجيشن
                    في الأندرويد، فكان بيتلزق في حافة الشاشة تمامًا. -->
            <Border IsVisible="{Binding ShowSuggestions}" VerticalOptions="End" BackgroundColor="White"
                    StrokeShape="RoundRectangle 18,18,0,0" Stroke="#EEEEEE" Padding="14,12,14,20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-3" Opacity="0.12" Radius="10"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Loc Key=FrequentlyBoughtTogether}"
                               FontFamily="CairoBold" FontSize="14" TextColor="#212121"/>
                        <Label Grid.Column="1" Text="✕" FontSize="16" TextColor="#9E9E9E">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DismissSuggestionsCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CollectionView ItemsSource="{Binding SuggestedProducts}" SelectionMode="None"
                                    ItemsLayout="HorizontalList" HeightRequest="184">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:Product">
                                <Border Style="{StaticResource Card}" WidthRequest="118" Margin="0,0,10,4" Padding="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Border BackgroundColor="#F0F0F0" StrokeShape="RoundRectangle 8"
                                                Stroke="#E0E0E0" HeightRequest="70">
                                            <Grid>
                                                <Label Text="🛒" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"
                                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}, ConverterParameter='invert'}"/>
                                                <ff:CachedImage Source="{Binding FullImageUrl}" Aspect="AspectFill"
                                                       CacheDuration="7" DownsampleToViewSize="True"
                                                       IsVisible="{Binding FullImageUrl, Converter={StaticResource HasImage}}"/>
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="11"
                                               MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding PriceText}" FontFamily="CairoBold" FontSize="12" TextColor="#FF5722"/>
                                        <Button Text="{loc:Loc Key=AddToCartShort}"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.AddSuggestedCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding HasVariants, Converter={StaticResource InvertBool}}"
                                                BackgroundColor="#FFF3E0" TextColor="#FF5722" FontFamily="CairoBold"
                                                FontSize="10" HeightRequest="28" CornerRadius="6" Padding="0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
